{
  "mcpInterceptors": [
    "my_package.mcp.auth:build_auth_interceptor"
  ],
  "mcpServers": {
    "github": {
      "enabled": false,
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_TOKEN": "$GITHUB_TOKEN"
      },
      "description": "GitHub MCP server for repository operations"
    },
    "postgres": {
      "enabled": false,
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://localhost/mydb"
      ],
      "env": {},
      "description": "PostgreSQL database access"
    },
    "ce-rag": {
      "enabled": false,
      "type": "http",
      "url": "http://localhost:8100/mcp",
      "description": "Example ce-rag MCP server for evidence retrieval and candidate recall"
    },
    "ce-db": {
      "enabled": false,
      "type": "http",
      "url": "http://localhost:8102/mcp",
      "description": "Example ce-db MCP server for readonly structured data access"
    }
  },
  "skills": {}
}
