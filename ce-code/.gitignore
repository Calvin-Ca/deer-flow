# ===== PDF 原始数据：不入 git（可能含版权内容、文件大）；清单入 git 作溯源 =====
data/raw/*
!data/raw/.gitkeep
!data/raw/manifest.md
!data/raw/*.pdf

# ===== 解析产物（MinerU）：入 git 同步（2026-06-16 起，省服务器重跑解析） =====
# data/parsed/  随 git 同步
# 但每份产物下的 images/（MinerU 切出的位图，大体积、可由原 PDF 重生）不入 git
data/parsed/**/images/

# ===== 结构化产物（chunk 树 / bill_spec.jsonl 等）：入 git 同步（2026-06-16 起） =====
# data/structured/  随 git 同步

# ===== 向量索引（BM25 + Milvus dump）：不入 git =====
data/vector_store/*
!data/vector_store/.gitkeep

# ===== 调试 notebook 输出 =====
notebooks/.ipynb_checkpoints/
notebooks/*.ipynb_checkpoints

# ===== Python 缓存 =====
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ===== 评测集：入 git 同步（CLAUDE.md 约定，2026-06-16 起生效） =====
# data/eval_set/  随 git 同步（json/jsonl 派生小文本）
# 例外：真实工程 xlsx 原件（版权敏感 + 大体积）不入 git，保留在 eval_set 本地
data/eval_set/*.xlsx

# ===== 评测结果：目录保留，文件不入 git =====
data/eval_results/*
!data/eval_results/.gitkeep

# ===== 自动生成的质量报告：目录保留，文件不入 git =====
data/quality_reports/*
!data/quality_reports/.gitkeep

# ===== PyTorch 临时目录（torch RPC/distributed 模块编译产物，落在 cwd） =====
tmp*/

# ===== 环境变量 =====
.env
.env.local

# ===== [norm-ft] 训练数据（jsonl 体量大，不入 git；manifest.json 入 git） =====
data/processed/group_*/train.jsonl
data/processed/group_*/manifest.json

# ===== [norm-ft] 中间产物：失败样本、过滤淘汰样本（调试用，不入 git） =====
data/interim/failed/*
!data/interim/failed/.gitkeep
data/interim/filtered_out/*
!data/interim/filtered_out/.gitkeep

# ===== [norm-ft] 推理结果（每次 run 产物，体量大）=====
results/*/raw/
results/*/figs/

# ===== [norm-ft] 模型 checkpoint =====
checkpoints/
