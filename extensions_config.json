{
  "mcpInterceptors": [
    "my_package.mcp.auth:build_auth_interceptor"
  ],
  "mcpServers": {
    "filesystem": {
      "enabled": false,
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/path/to/allowed/files"
      ],
      "env": {},
      "description": "Provides filesystem access within allowed directories"
    },
    "github": {
      "enabled": false,
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_TOKEN": "$GITHUB_TOKEN"
      },
      "description": "GitHub MCP server for repository operations"
    },
    "postgres": {
      "enabled": false,
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://localhost/mydb"
      ],
      "env": {},
      "description": "PostgreSQL database access"
    },
    "ce-cost": {
      "enabled": true,
      "type": "http",
      "url": "http://localhost:8100/mcp",
      "description": "深圳房建组价取数原语：bill_match / quota_lookup / price_compose（按国标版本 spec 隔离 2013/2024）"
    }
  },
  "skills": {
    "norm-qa": {
      "enabled": true
    },
    "cost-agent": {
      "enabled": true
    },
    "academic-paper-review": {
      "enabled": false
    },
    "bootstrap": {
      "enabled": false
    },
    "chart-visualization": {
      "enabled": false
    },
    "claude-to-deerflow": {
      "enabled": false
    },
    "code-documentation": {
      "enabled": false
    },
    "consulting-analysis": {
      "enabled": false
    },
    "data-analysis": {
      "enabled": false
    },
    "deep-research": {
      "enabled": false
    },
    "find-skills": {
