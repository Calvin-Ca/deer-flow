# Langfuse 自托管 —— 覆盖项（可选）
#
# docker-compose.yaml 里所有值都内置了默认值，不放本文件也能直接 `docker compose up -d` 跑通。
# 仅当你要换密钥 / 改端口 / 改登录账号时，复制本文件为 .env 并填写。
#   cp .env.example .env
# 注意：本目录的 .env 已被仓库根 .gitignore 忽略（不会同步 / 不进 git）。
#
# 重新生成全套密钥（务必同步改 deer-flow 侧的 LANGFUSE_PUBLIC_KEY/SECRET_KEY）：
#   ENCRYPTION_KEY      : openssl rand -hex 32
#   NEXTAUTH_SECRET/SALT: openssl rand -base64 32
#   各服务密码           : openssl rand -hex 16

# ── Web UI 端口（宿主机）。3000 被 deer-flow 前端占用，默认用 3030 ──
LANGFUSE_WEB_PORT=3030
# 远程访问请把 localhost 换成服务器 IP/域名，否则登录回调会失败
NEXTAUTH_URL=http://localhost:3030

# ── 应用安全密钥 ──
ENCRYPTION_KEY=417184d53bb04353fbb18183e3914cae0b60a8dec01e8f19f0c8465c5c41cce8
NEXTAUTH_SECRET=vPx76qI4R7yqb2EuDR5to8nuocFURCgZEK49Q1a5Q+M=
SALT=FkkV/FYoVaVcNW4YqzcL+0gwrvFKzGMpYc4qh5tj9GA=

# ── 内部存储密码（这些服务不对外暴露端口，密码仅容器间使用）──
POSTGRES_PASSWORD=758812007d952668c4193f3fd8fb9717
CLICKHOUSE_PASSWORD=f22cc8a47a250f8644230a7692eff5ab
REDIS_AUTH=ba0c6aee03df61d8d660e4706e2ba4d7
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=afe13a9ee11cbd3408ac2d4d64b3e201

# ── 首次启动自动创建的登录账号 ──
LANGFUSE_INIT_USER_EMAIL=admin@deerflow.local
LANGFUSE_INIT_USER_NAME=Admin
LANGFUSE_INIT_USER_PASSWORD=24b2ae94b499d4dc38c36f65

# ── 自动创建的 project 与 API Key（= deer-flow 侧要填的公钥/私钥）──
LANGFUSE_INIT_ORG_ID=deerflow
LANGFUSE_INIT_ORG_NAME=DeerFlow
LANGFUSE_INIT_PROJECT_ID=deerflow
LANGFUSE_INIT_PROJECT_NAME=deer-flow
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-f8233b5e-1a4b-4561-ad52-40ed09152898
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-9a357125-10bc-42da-a4a0-f520026bd5b7

# 关闭匿名使用统计上报
TELEMETRY_ENABLED=false
