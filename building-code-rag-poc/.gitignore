# ===== PDF 原始数据：不入 git（可能含版权内容、文件大） =====
data/raw/*
!data/raw/.gitkeep

# ===== 解析产物：不入 git（可重新生成、文件大） =====
data/parsed/*
!data/parsed/.gitkeep

# ===== 结构化条款库：不入 git（可重新生成） =====
data/structured/*
!data/structured/.gitkeep

# ===== 向量索引（BM25 + Milvus dump）：不入 git =====
data/vector_store/*
!data/vector_store/.gitkeep

# ===== 调试 notebook 输出 =====
notebooks/.ipynb_checkpoints/
notebooks/*.ipynb_checkpoints

# ===== Python 缓存 =====
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ===== 评测集：目录保留，文件不入 git =====
data/eval_set/*
!data/eval_set/.gitkeep

# ===== 自动生成的质量报告：目录保留，文件不入 git =====
data/quality_reports/*
!data/quality_reports/.gitkeep

# ===== 环境变量 =====
.env
.env.local
