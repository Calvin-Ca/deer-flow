# ===== PDF 原始数据：不入 git（可能含版权内容、文件大）；清单入 git 作溯源 =====
data/raw/*
!data/raw/.gitkeep
!data/raw/manifest.md

# ===== 解析产物（MinerU）：入 git 同步（2026-06-16 起，省服务器重跑解析） =====
# data/parsed/  随 git 同步

# ===== 结构化产物（chunk 树 / bill_spec.jsonl 等）：入 git 同步（2026-06-16 起） =====
# data/structured/  随 git 同步

# ===== 向量索引（BM25 + Milvus dump）：不入 git =====
data/vector_store/*
!data/vector_store/.gitkeep

# ===== 调试 notebook 输出 =====
notebooks/.ipynb_checkpoints/
notebooks/*.ipynb_checkpoints

# ===== Python 缓存 =====
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ===== 评测集：入 git 同步（CLAUDE.md 约定，2026-06-16 起生效） =====
# data/eval_set/  随 git 同步

# ===== 评测结果：目录保留，文件不入 git =====
data/eval_results/*
!data/eval_results/.gitkeep

# ===== 自动生成的质量报告：目录保留，文件不入 git =====
data/quality_reports/*
!data/quality_reports/.gitkeep

# ===== PyTorch 临时目录（torch RPC/distributed 模块编译产物，落在 cwd） =====
tmp*/

# ===== 环境变量 =====
.env
.env.local
