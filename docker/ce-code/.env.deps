# ce-code 依赖数据服务（docker-compose.deps.yaml）环境变量
# 用法：cp .env.deps.example .env.deps 后按需改；compose 以 --env-file docker/ce-code/.env.deps 引用。

# 数据卷根目录（务必落大盘 nvme，勿用 / 或 home 小盘）
CE_DATA_ROOT=/mnt/nvme/calvin/data/ce-code

# PostgreSQL（与 config/cost.query DEFAULT_DSN = localhost:5433/ce_cost 一致；密码弱、仅内网 dev）
POSTGRES_USER=cost
POSTGRES_DB=ce_cost
POSTGRES_PASSWORD=caic

# MinIO（Milvus 对象存储后端；保持 minioadmin 即可，Milvus 默认凭据）
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin
