# 建筑规范 RAG —— 环境变量配置
# 复制为 .env 并按服务器实际路径修改：
#   cp docker/ce-services/.env.example docker/ce-services/.env

# ── 必填 ─────────────────────────────────────────────────────────────────────

# ce-code/data/ 在服务器上的绝对路径（包含 vector_store/、eval_set/ 等）
DATA_DIR=/mnt/nvme/calvin/code/deer-flow/ce-code/data

# ── 可选（有默认值）──────────────────────────────────────────────────────────

# GPU 编号（默认 2，即服务器上空闲显存最多的那块）
CUDA_DEVICE=2

# HuggingFace 模型缓存目录（bge-reranker-large 缓存于此，避免重复下载）
HF_CACHE=/home/caic/.cache/huggingface

# 知识服务地址（任务服务用；默认 localhost:8100）
KNOWLEDGE_URL=http://localhost:8100

# Qwen3-8B vLLM 地址与 model_id
LLM_URL=http://localhost:8099
LLM_MODEL_ID=qwen3-8b

# HITL 会话持久化卷的宿主根目录（tasks 服务把 SqliteSaver 落到 $CE_DATA_ROOT/ce-services/，
# 绑大盘、容器重建不丢会话；默认与 deps 数据卷同盘）
CE_DATA_ROOT=/mnt/nvme/calvin/data/ce-code

# 造价库 PG 连接串（knowledge 的 /price/compose /price/query /bill/get 依赖；真实密码只进 .env 不入 git）
CE_PG_DSN=postgresql://cost:改成真实密码@localhost:5433/ce_cost

# 可选·桶B(32B) 升级：设了才把选码/编排指向 32B，否则一切走 8b（见 common/config.py）
# ORCH_LLM_URL=http://172.19.2.2:8001/v1
# ORCH_LLM_MODEL_ID=qwen3-32b
# 可选·编码闸置信阈值 τ（默认 0.75，保守多停）
# HITL_CONFIDENCE_TAU=0.75

# 可选·规范问答联网兜底（默认开；服务器无公网路由 → 设 0 显式关，零召回直接拒答给出路）
# CE_NORM_WEB_FALLBACK=0
# 可选·组价缺省国标版本（默认 2013=PRD 口径；过渡期要完整组价体验可切 2024）
# CE_COST_DEFAULT_SPEC=2013
